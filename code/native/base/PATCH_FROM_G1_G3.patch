+    CostScope display(costs, NewtonCost::Diagnostics);
+    std::cout << "\nEXIT: " << result.message << std::endl;
+  }
+  {
+    CostScope cleanup(costs, NewtonCost::Cleanup);
+    owner.reset();
+  }
+  costs.finish();
+  result.elapsed_seconds = seconds(start);
+  return result;
+}
