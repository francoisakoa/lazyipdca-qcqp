+    p.objective.name="f";
+    p.objective.linear={-1.0};
+    p.objective.hessian.n=1;
+
+    QuadraticFunction ball;
+    ball.name="ball";
+    ball.constant=-1.0;
+    ball.linear={0.0};
+    ball.hessian.n=1;
+    ball.hessian.entries={{0,0,2.0}}; // x^2-1 <= 0
+    p.inequalities={ball};
+    p.validate();
+
+    Settings st;
+    st.outer_algorithm="lazy-dca";
+    st.inner_backend="lazyqp";
+    st.linear_backend="native";
+    st.verbose=false;
+    st.max_outer_iterations=20;
+    st.max_inner_iterations=200;
+    st.feasibility_tolerance=1e-6;
+    st.stationarity_tolerance=1e-5;
+    st.dual_infeasibility_tolerance=1e-5;
+    st.complementarity_tolerance=1e-5;
+    st.inner_tolerance=1e-8;
+    st.inner_iteration_limit_mu_fallback=1e-6;
+    // First reproduce the defective restricted master explicitly.  With the
+    // safeguard disabled, the only bounding row is omitted at x0=0 and the
+    // first convex subproblem cannot deliver an outer step.
+    Settings restricted=st;
+    restricted.dca_full_constraints_for_affine_objective=false;
+    restricted.max_inner_iterations=8;
+    const Result broken=Solver(restricted).solve(p);
+    if(broken.status==Status::Solved || broken.outer_iterations!=0)
+      throw std::runtime_error("restricted affine master unexpectedly entered optimization");
+
+    st.dca_full_constraints_for_affine_objective=true;
+    st.dca_affine_full_constraint_limit=16;
+
+    const Result r=Solver(st).solve(p);
+    if(r.status!=Status::Solved)
+      throw std::runtime_error("affine full-majorant master failed: "+r.message);
+    if(r.outer_iterations<1)
+      throw std::runtime_error("solver never entered the outer optimization");
+    if(r.x.size()!=1 || std::abs(r.x[0]-1.0)>5e-5)
+      throw std::runtime_error("wrong affine full-majorant solution");
+    if(r.feasibility.total_inf>st.feasibility_tolerance)
+      throw std::runtime_error("affine full-majorant solution is infeasible");
+    if(r.working_set_additions!=0)
+      throw std::runtime_error("full-majorant mode unexpectedly used lazy activation");
+    if(r.active_inequalities<1)
+      throw std::runtime_error("bounding constraint was not retained");
+
+    std::cout << "[PASS] affine-objective full majorant enters optimization"
+              << " outer="<<r.outer_iterations
+              << " inner="<<r.inner_iterations
+              << " x="<<r.x[0]<<"\n";
+    return 0;
+  } catch(const std::exception& e) {
+    std::cerr << "[FAIL] "<<e.what()<<"\n";
+    return 1;
+  }
+}
diff --git a/tests/test_lazy_dca_affine_full_shape.cpp b/tests/test_lazy_dca_affine_full_shape.cpp
new file mode 100644
index 0000000..7eb0244
--- /dev/null
+++ b/tests/test_lazy_dca_affine_full_shape.cpp
@@ -0,0 +1,109 @@
+#include "lazyipdca_qcqp/solver.hpp"
+
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+#include <string>
+
+using namespace lazyipdca::qcqp;
+
+int main() {
+  try {
+    constexpr int n=130;
+    constexpr int mi=384;
+    const double inf=std::numeric_limits<double>::infinity();
+
+    // A structural first-subproblem surrogate for A4X12: affine objective,
+    // 130 variables, one equality, 384 quadratic inequalities, and many
+    // negative-curvature rows.  The optimum is deliberately simple so this
+    // test isolates model assembly, full affine-objective retention, low-rank
+    // condensation, and the coupled LazyQP step rather than benchmark data.
+    QCQPProblem p;
+    p.name="affine_full_shape_130_1_384";
+    p.n=n;
+    p.x0.assign(n,0.0);
+    p.lb.assign(n,-inf);
+    p.ub.assign(n,inf);
+    p.objective.name="f";
+    p.objective.linear.assign(n,0.0);
+    p.objective.linear[0]=-1.0;
+    p.objective.hessian.n=n;
+
+    QuadraticFunction equality;
+    equality.name="fixed_tail";
+    equality.linear.assign(n,0.0);
+    equality.linear[n-1]=1.0;
+    equality.hessian.n=n;
+    p.equalities.push_back(equality);
+
+    QuadraticFunction bounding_ball;
+    bounding_ball.name="x0_ball";
+    bounding_ball.constant=-1.0;
+    bounding_ball.linear.assign(n,0.0);
+    bounding_ball.hessian.n=n;
+    bounding_ball.hessian.entries={{0,0,2.0}}; // x_0^2 <= 1
+    p.inequalities.push_back(bounding_ball);
+
+    for(int i=1;i<mi;++i) {
+      QuadraticFunction g;
+      g.name="g"+std::to_string(i);
+      g.constant=-4.0;
+      g.linear.assign(n,0.0);
+      g.hessian.n=n;
+      const int j=1+(i%128);
+      const int k=1+((i+37)%128);
+      if(i%2==0) {
+        g.hessian.entries={{j,j,2.0}};
+      } else if(j<k) {
+        g.hessian.entries={{j,j,2.0},{k,k,-2.0}};
+      } else {
+        g.hessian.entries={{k,k,-2.0},{j,j,2.0}};
+      }
+      p.inequalities.push_back(std::move(g));
+    }
+    p.validate();
+
+    Settings st;
+    st.outer_algorithm="lazy-dca";
+    st.inner_backend="lazyqp";
+    st.linear_backend="native";
+    st.verbose=false;
+    st.max_outer_iterations=20;
+    st.max_inner_iterations=200;
+    st.feasibility_tolerance=1e-6;
+    st.stationarity_tolerance=1e-5;
+    st.dual_infeasibility_tolerance=1e-5;
+    st.complementarity_tolerance=1e-5;
+    st.inner_tolerance=1e-7;
+    st.inner_iteration_limit_mu_fallback=1e-6;
+    st.dca_full_constraints_for_affine_objective=true;
+    st.dca_affine_full_constraint_limit=4096;
+    st.exact_eigen_threshold=256;
+    st.max_rank_per_quadratic=24;
+
+    const Result r=Solver(st).solve(p);
+    if(r.status!=Status::Solved)
+      throw std::runtime_error("130/1/384 full-majorant surrogate failed: "+r.message);
+    if(r.outer_iterations<1)
+      throw std::runtime_error("130/1/384 surrogate never entered outer optimization");
+    if(r.x.size()!=n || std::abs(r.x[0]-1.0)>1e-4)
+      throw std::runtime_error("130/1/384 surrogate returned wrong minimizer");
+    if(r.feasibility.total_inf>st.feasibility_tolerance)
+      throw std::runtime_error("130/1/384 surrogate is infeasible");
+    if(r.inequality_total_rank<100)
+      throw std::runtime_error("negative-curvature rows were not retained/condensed");
+    if(r.working_set_additions!=0)
+      throw std::runtime_error("full-majorant surrogate unexpectedly used lazy activation");
+
+    std::cout << "[PASS] affine full-majorant shape 130/1/384"
+              << " outer="<<r.outer_iterations
+              << " inner="<<r.inner_iterations
+              << " rank="<<r.inequality_total_rank
+              << " x0="<<r.x[0]<<"\n";
+    return 0;
+  } catch(const std::exception& e) {
+    std::cerr << "[FAIL] "<<e.what()<<"\n";
+    return 1;
+  }
+}
diff --git a/tests/test_lazyqp_dual_step_coupling.cpp b/tests/test_lazyqp_dual_step_coupling.cpp
new file mode 100644
index 0000000..63e8afb
--- /dev/null
+++ b/tests/test_lazyqp_dual_step_coupling.cpp
@@ -0,0 +1,88 @@
+#include "lazyipdca_qcqp/inner_lazyqp.hpp"
+
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+
+using namespace lazyipdca::qcqp;
+
+static ConvexSubproblem make_dual_jump_problem() {
+  ConvexSubproblem p;
+  p.nvar=2;
+  p.original_dimension=2;
+  p.prefer_feasible_centered_start=true;
+
+  // A nearly flat objective direction creates a very large primal Newton
+  // component.  Its dual component must be damped whenever that primal
+  // component is backtracked by the exact nonlinear residual test.
+  p.objective.constant=0.0;
+  p.objective.linear={-0.9,-0.0945696};
+  p.objective.base_hessian.n=2;
+  p.objective.base_hessian.entries={{1,1,1e-16}};
+
+  // x + 0.5e-14 y^2 <= 0 and x >= -1.  The optimum is
+  // x=-1, y=sqrt(2e14).  The problem is convex and strictly feasible.
+  ConvexQuadraticModel curved;
+  curved.constant=0.0;
+  curved.linear={1.0,0.0};
+  curved.base_hessian.n=2;
+  curved.base_hessian.entries={{1,1,1e-14}};
+  p.inequalities.push_back(curved);
+
+  ConvexQuadraticModel x_lower;
+  x_lower.constant=-1.0;
+  x_lower.linear={-1.0,0.0};
+  x_lower.base_hessian.n=2;
+  p.inequalities.push_back(x_lower);
+
+  // Reproduce the many-row barrier scaling of the failure without adding
+  // curvature or changing the minimizer.  These rows are strictly inactive.
+  for(int i=0;i<100;++i) {
+    ConvexQuadraticModel redundant;
+    redundant.constant=-1e-4;
+    redundant.linear={0.0,0.0};
+    redundant.base_hessian.n=2;
+    p.inequalities.push_back(redundant);
+  }
+
+  p.equalities.nvar=2;
+  return p;
+}
+
+int main() {
+  try {
+    Settings st;
+    st.verbose=false;
+    st.max_inner_iterations=100;
+    st.inner_tolerance=1e-7;
+    st.inner_iteration_limit_mu_fallback=1e-6;
+
+    const InnerResult r=ConvexQCQPLazyQPKernel(st).solve(make_dual_jump_problem());
+    if(!r.success)
+      throw std::runtime_error("coupled-step LazyQP failed: "+r.message);
+    if(r.message.find("nonlinear-residual")==std::string::npos)
+      throw std::runtime_error("dual-step regression did not use nonlinear-residual LazyQP");
+    if(r.y.size()!=2 || !std::isfinite(r.y[0]) || !std::isfinite(r.y[1]))
+      throw std::runtime_error("dual-step regression returned invalid primal variables");
+
+    const double expected_y=std::sqrt(2.0e14);
+    if(std::abs(r.y[0]+1.0)>1e-5 ||
+       std::abs(r.y[1]-expected_y)>2e-5*expected_y)
+      throw std::runtime_error("dual-step regression converged to the wrong minimizer");
+    if(r.dual_inf>5e-6 || r.primal_residual_inf>5e-6 ||
+       r.inequality_inf>5e-6 || r.complementarity>2e-6)
+      throw std::runtime_error("dual-step regression KKT residual is too large");
+    if(r.iterations>=60)
+      throw std::runtime_error("dual-step regression lost the coupled-step escape");
+
+    std::cout << "[PASS] LazyQP coupled-step regression it="<<r.iterations
+              << " dual="<<r.dual_inf
+              << " pri="<<r.primal_residual_inf
+              << " mu="<<r.complementarity
+              << " y="<<r.y[1]<<"\n";
+    return 0;
+  } catch(const std::exception& e) {
+    std::cerr << "[FAIL] "<<e.what()<<"\n";
+    return 1;
+  }
+}
diff --git a/tests/test_lazyqp_fixed_native_shift.cpp b/tests/test_lazyqp_fixed_native_shift.cpp
new file mode 100644
index 0000000..8546346
--- /dev/null
+++ b/tests/test_lazyqp_fixed_native_shift.cpp
@@ -0,0 +1,69 @@
+#include "lazyipdca_qcqp/inner_lazyqp.hpp"
+
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace lazyipdca::qcqp;
+
+static ConvexSubproblem make_flat_problem() {
+  ConvexSubproblem p;
+  p.nvar=1;
+  p.original_dimension=1;
+  p.prefer_feasible_centered_start=true;
+
+  // With no objective Hessian and no constraint Jacobian, the primal KKT row
+  // is identically zero unless the Settings-level primal shift is assembled.
+  p.objective.constant=0.0;
+  p.objective.linear={-1.0};
+  p.objective.base_hessian.n=1;
+
+  ConvexQuadraticModel inactive;
+  inactive.constant=-1.0;
+  inactive.linear={0.0};
+  inactive.base_hessian.n=1;
+  p.inequalities.push_back(inactive);
+
+  p.equalities.nvar=1;
+  return p;
+}
+
+int main() {
+  try {
+    Settings no_shift;
+    no_shift.verbose=false;
+    no_shift.linear_backend="native";
+    no_shift.kkt_adaptive_regularization=false;
+    no_shift.kkt_primal_regularization=0.0;
+    no_shift.kkt_dual_regularization=0.0;
+    no_shift.max_inner_iterations=1;
+
+    const InnerResult singular=ConvexQCQPLazyQPKernel(no_shift).solve(make_flat_problem());
+    if(singular.message.find("KKT factorization failed")==std::string::npos)
+      throw std::runtime_error("unshifted flat KKT did not expose the singular native system");
+
+    Settings shifted=no_shift;
+    shifted.kkt_primal_regularization=1e-6;
+    shifted.kkt_dual_regularization=1e-8;
+    const InnerResult regularized=ConvexQCQPLazyQPKernel(shifted).solve(make_flat_problem());
+
+    if(regularized.message.find("KKT factorization failed")!=std::string::npos)
+      throw std::runtime_error("fixed native KKT shifts were not assembled");
+    if(regularized.factorizations<1)
+      throw std::runtime_error("regularized native KKT was not factored");
+    if(std::abs(regularized.final_kkt_rho_x-shifted.kkt_primal_regularization)>1e-18)
+      throw std::runtime_error("reported rho_x does not match the assembled fixed shift");
+    if(std::abs(regularized.final_kkt_delta_d-shifted.kkt_dual_regularization)>1e-18)
+      throw std::runtime_error("reported delta_d does not match the assembled fixed shift");
+
+    std::cout << "[PASS] LazyQP native fixed KKT shift rho_x="
+              << regularized.final_kkt_rho_x
+              << " delta_d=" << regularized.final_kkt_delta_d
+              << " fact=" << regularized.factorizations << "\n";
+    return 0;
+  } catch(const std::exception& e) {
+    std::cerr << "[FAIL] " << e.what() << "\n";
+    return 1;
+  }
+}
diff --git a/tests/test_lazyqp_lowrank_condensation.cpp b/tests/test_lazyqp_lowrank_condensation.cpp
new file mode 100644
index 0000000..7a0513f
--- /dev/null
+++ b/tests/test_lazyqp_lowrank_condensation.cpp
@@ -0,0 +1,74 @@
+#include "lazyipdca_qcqp/inner_lazyqp.hpp"
+
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+
+using namespace lazyipdca::qcqp;
+
+static ConvexSubproblem make_problem() {
+  ConvexSubproblem p;
+  p.nvar=2;
+  p.original_dimension=2;
+  p.prefer_feasible_centered_start=true;
+
+  p.objective.linear={-1.0,-0.2};
+  p.objective.base_hessian.n=2;
+  p.objective.base_hessian.entries={{0,0,0.2},{1,1,0.2}};
+  p.objective.low_rank.push_back({1.0,{1.0,1.0}});
+
+  ConvexQuadraticModel curved;
+  curved.constant=-1.0;
+  curved.linear={0.0,0.0};
+  curved.base_hessian.n=2;
+  curved.low_rank.push_back({2.0,{1.0,0.0}}); // x_0^2 <= 1
+  p.inequalities.push_back(curved);
+
+  ConvexQuadraticModel lower;
+  lower.constant=-1.0;
+  lower.linear={0.0,-1.0};
+  lower.base_hessian.n=2;
+  p.inequalities.push_back(lower);
+
+  ConvexQuadraticModel upper;
+  upper.constant=-1.0;
+  upper.linear={0.0,1.0};
+  upper.base_hessian.n=2;
+  p.inequalities.push_back(upper);
+
+  p.equalities.nvar=2;
+  return p;
+}
+
+int main() {
+  try {
+    Settings condensed;
+    condensed.verbose=false;
+    condensed.max_inner_iterations=200;
+    condensed.inner_tolerance=1e-8;
+    condensed.inner_iteration_limit_mu_fallback=1e-6;
+    condensed.exact_eigen_threshold=256;
+
+    Settings bordered=condensed;
+    bordered.exact_eigen_threshold=0;
+
+    const InnerResult rc=ConvexQCQPLazyQPKernel(condensed).solve(make_problem());
+    const InnerResult rb=ConvexQCQPLazyQPKernel(bordered).solve(make_problem());
+    if(!rc.success || !rb.success)
+      throw std::runtime_error("condensed/bordered low-rank solve failed");
+    if(rc.y.size()!=2 || rb.y.size()!=2)
+      throw std::runtime_error("condensed/bordered low-rank dimension mismatch");
+    if(std::abs(rc.y[0]-rb.y[0])>1e-7 || std::abs(rc.y[1]-rb.y[1])>1e-7)
+      throw std::runtime_error("condensed and bordered low-rank KKT solutions differ");
+    if(std::abs(rc.y[0]-1.0)>5e-5 || std::abs(rc.y[1]+2.0/3.0)>5e-5)
+      throw std::runtime_error("low-rank condensation returned wrong minimizer");
+
+    std::cout << "[PASS] exact low-rank condensation matches bordered KKT"
+              << " y="<<rc.y[0]<<","<<rc.y[1]
+              << " it="<<rc.iterations<<"\n";
+    return 0;
+  } catch(const std::exception& e) {
+    std::cerr << "[FAIL] "<<e.what()<<"\n";
+    return 1;
+  }
+}
