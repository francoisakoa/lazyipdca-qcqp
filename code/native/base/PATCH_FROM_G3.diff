+#!/usr/bin/env bash
+# Activate the chosen Conda environment before calling this script.
+set -Eeuo pipefail
+SRC=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+BUILD_DIR=${BUILD_DIR:-$SRC/build_pf_gpu}
+BUILD_JOBS=${BUILD_JOBS:-4}
+TEST_JOBS=${TEST_JOBS:-2}
+CMAKE=${CMAKE:-cmake}
+CTEST=${CTEST:-ctest}
+args=(
+  -S "$SRC" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release
+  -DLAZYIPDCA_NATIVE_ARCH=ON -DLAZYIPDCA_BUILD_TESTS=ON
+  -DLAZYIPDCA_WITH_IPOPT=OFF -DLAZYIPDCA_WITH_QDLDL=OFF
+  -DLAZYIPDCA_WITH_MUMPS=OFF -DLAZYIPDCA_WITH_LDL=ON
+  -DLAZYIPDCA_REQUIRE_HISTORICAL_LDL=ON
+)
+if [[ -n ${CONDA_PREFIX:-} ]]; then
+  args+=("-DCMAKE_PREFIX_PATH=$CONDA_PREFIX" "-DLDL_ROOT=$CONDA_PREFIX" "-DMETIS_ROOT=$CONDA_PREFIX")
+fi
+"$CMAKE" "${args[@]}" "$@"
+"$CMAKE" --build "$BUILD_DIR" --parallel "$BUILD_JOBS"
+OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 BLIS_NUM_THREADS=1 \
+  "$CTEST" --test-dir "$BUILD_DIR" --output-on-failure --parallel "$TEST_JOBS"
+"$BUILD_DIR/lazyipdca_qcqp_cli" --version
+printf 'BINARY=%s\nBUILD=PASS\n' "$BUILD_DIR/lazyipdca_qcqp_cli"
