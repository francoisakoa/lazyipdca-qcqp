+#!/usr/bin/env bash
+set -Eeo pipefail
+umask 022
+ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+: "${CONDA_PREFIX:?Activer Conda avant de compiler}"
+BUILD="$ROOT/build_pf_gpu"
+cmake -S "$ROOT" -B "$BUILD" -G Ninja \
+  -DCMAKE_BUILD_TYPE=Release -DLAZYIPDCA_NATIVE_ARCH=ON \
+  -DPython3_EXECUTABLE="$(command -v python)" \
+  -DLDL_ROOT="$CONDA_PREFIX" -DMETIS_ROOT="$CONDA_PREFIX" \
+  -DLAZYIPDCA_WITH_LDL=ON -DLAZYIPDCA_WITH_METIS=ON \
+  -DLAZYIPDCA_REQUIRE_HISTORICAL_LDL=ON -DLAZYIPDCA_BUILD_TESTS=ON
+cmake --build "$BUILD" --parallel "${BUILD_JOBS:-8}"
+OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 BLIS_NUM_THREADS=1 \
+  ctest --test-dir "$BUILD" --output-on-failure
+"$BUILD/lazyipdca_qcqp_cli" --version
+printf 'BINARY=%s\n' "$BUILD/lazyipdca_qcqp_cli"
