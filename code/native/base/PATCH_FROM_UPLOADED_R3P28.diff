+    if(st.verbose)std::cout<<"[LAZY-NEWTON-NATIVE] k="<<stats.accepted_steps<<" trigger="<<trigger
+        <<" rho="<<regularization<<" dim="<<dim<<" seconds="<<elapsed<<" factor_ok="<<ok
+        <<" sparse_reason="<<sparse_reason<<" native_reason="<<native_message<<"\n";
