+    Vec offset(n,0.0);for(int e=0;e<me;++e)if(pivot_variable[e]>=0)offset[pivot_variable[e]]=-eq[e]/pivot_coefficient[e];
+    Vec b=hessian_product(offset);for(int j=0;j<n;++j)b[j]+=dual[j];
+    Vec rhs(dim,0.0);
