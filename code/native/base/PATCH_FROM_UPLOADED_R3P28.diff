+    if(st.lazy_newton_atom_guided&&atom_adaptation_active) {
+      if(atom_guide_iteration!=stats.accepted_steps){atom_guides.clear();atom_guide_iteration=stats.accepted_steps;}
+      for(auto& w:atom_guides) {
